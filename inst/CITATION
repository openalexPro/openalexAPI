citHeader("To cite openalexAPI in publications use:")

# Version and year come from the installed package, so nothing to bump at release.
# The DOI is Zenodo's concept DOI: it always resolves to the latest version.
year <- substr(c(meta$`Date/Publication`, meta$Date, meta$Packaged, format(Sys.Date()))[1], 1, 4)

bibentry(
  bibtype = "Manual",
  key     = "openalexAPI",
  title   = "{openalexAPI}: Local OpenAlex-Compatible Web API over a Parquet Corpus",
  author  = person("Rainer M", "Krug", comment = c(ORCID = "0000-0002-7490-0066")),
  year    = year,
  note    = paste("R package version", meta$Version),
  doi     = "10.5281/zenodo.24514237",
  url     = "https://github.com/openalexPro/openalexAPI",
  textVersion = paste0(
    "Krug, R. M. (", year, "). openalexAPI: Local OpenAlex-Compatible Web API over a ",
    "Parquet Corpus. R package version ", meta$Version, ". https://doi.org/10.5281/zenodo.24514237"
  )
)

bibentry(
  header  = "openalexAPI is part of the openalexPro ecosystem; to cite the ecosystem as a whole use:",
  bibtype = "Misc",
  key     = "openalexProEcosystem",
  title   = "The {openalexPro} ecosystem: R packages for large-scale work with OpenAlex",
  author  = person("Rainer M", "Krug", comment = c(ORCID = "0000-0002-7490-0066")),
  year    = year,
  url     = "https://openalexpro.github.io/",
  textVersion = paste0(
    "Krug, R. M. (", year, "). The openalexPro ecosystem: R packages for ",
    "large-scale work with OpenAlex. https://openalexpro.github.io/"
  )
)
